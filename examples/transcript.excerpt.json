[
 {
  "start": 0.0,
  "end": 1.92,
  "text": "大家好我是程序员余皮"
 },
 {
  "start": 1.92,
  "end": 4.72,
  "text": "每年求职季我都会分享一些求职攻略"
 },
 {
  "start": 4.72,
  "end": 7.52,
  "text": "这些年我帮大家修改过几千份简历"
 },
 {
  "start": 7.52,
  "end": 9.48,
  "text": "之前写的保姆级写简历指南"
 },
 {
  "start": 9.48,
  "end": 12.04,
  "text": "也帮不少同学拿到了面试机会"
 },
 {
  "start": 12.04,
  "end": 13.92,
  "text": "所以在写简历这件事情上"
 },
 {
  "start": 13.92,
  "end": 15.92,
  "text": "还是有一点发言权的"
 },
 {
  "start": 15.92,
  "end": 17.56,
  "text": "不过随着AI的发展"
 },
 {
  "start": 17.56,
  "end": 21.04,
  "text": "程序员的简历写法也必须要征新了"
 },
 {
  "start": 21.04,
  "end": 22.12,
  "text": "如今的招聘市场"
 },
 {
  "start": 22.12,
  "end": 24.4,
  "text": "汇AI已经不是加分项"
 },
 {
  "start": 24.4,
  "end": 26.48,
  "text": "而是筛选条件"
 },
 {
  "start": 26.48,
  "end": 28.2,
  "text": "随便翻翻现在大厂的JD"
 },
 {
  "start": 28.2,
  "end": 29.64,
  "text": "很多都明确写着"
 },
 {
  "start": 29.64,
  "end": 31.7,
  "text": "熟悉AI大模型开发优先"
 },
 {
  "start": 31.7,
  "end": 33.78,
  "text": "有AI编程经验优先"
 },
 {
  "start": 33.78,
  "end": 37.34,
  "text": "所以如果你的简历上还是轻一色的CRUD项目"
 },
 {
  "start": 37.34,
  "end": 40.1,
  "text": "连一个AI相关的关键词都没有"
 },
 {
  "start": 40.1,
  "end": 42.98,
  "text": "那大概率第一轮筛选就被刷掉了"
 },
 {
  "start": 42.98,
  "end": 46.86,
  "text": "而且AI时代对程序员的能力边界有了很大的扩展"
 },
 {
  "start": 46.86,
  "end": 50.62,
  "text": "以前我们说全站可能就是前端加后端"
 },
 {
  "start": 50.62,
  "end": 51.78,
  "text": "但现在呢"
 },
 {
  "start": 51.78,
  "end": 53.7,
  "text": "你要会传统的后端开发"
 },
 {
  "start": 53.7,
  "end": 55.62,
  "text": "还得会AI应用开发"
 },
 {
  "start": 55.62,
  "end": 57.82,
  "text": "还得会AI编程工具提效"
 }
]

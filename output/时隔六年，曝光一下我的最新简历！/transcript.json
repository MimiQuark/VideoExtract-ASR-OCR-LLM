    "start": 433.68,
    "end": 435.76,
    "text": "而且字字珠鸡"
  },
  {
    "start": 435.76,
    "end": 437.7,
    "text": "我来给大家拆解一下"
  },
  {
    "start": 437.7,
    "end": 439.62,
    "text": "第一层 AI开发框架"
  },
  {
    "start": 439.62,
    "end": 441.1,
    "text": "这是核心技术能力"
